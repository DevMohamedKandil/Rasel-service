# Copy to deploy/.env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32   (PowerShell: -join ((1..32)|%{'{0:x2}' -f (Get-Random -Max 256)}))

# Host port the API is published on (put a TLS reverse proxy in front of it)
RASEL_PORT=8080

# Required. >= 32 chars, different from each other, not the dev placeholders
SECURITY_OTP_PEPPER=
SECURITY_TOKEN_SECRET=

# Required. Initial API key of the seeded "dev" client (only used while the database has no client). >= 16 chars
SEED_API_KEY=

# Shared secret between API and sidecar (>= 16 chars)
BRIDGE_SHARED_TOKEN=

# Fake = nothing is ever sent. Bridge = real WhatsApp through the sidecar
WHATSAPP_PROVIDER=Fake

# Comma-free single origin of the admin UI, empty = CORS disabled
CORS_ORIGIN=

# Optional signed webhooks
WEBHOOKS_ENABLED=false
WEBHOOKS_URL=
WEBHOOKS_SECRET=
