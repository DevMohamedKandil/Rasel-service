{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Database": { "Path": "rasel.db" },
  // DEV-ONLY placeholder secrets. Override with environment variables (e.g. Security__OtpPepper) in any real deployment.
  "Security": {
    "OtpPepper": "dev-only-otp-pepper-change-me",
    "TokenSecret": "dev-only-token-signing-secret-change-me-32+chars"
  },
  // Optional: set Seed__DevApiKey to choose the dev key; otherwise a random one is generated and logged once.
  "Seed": { "DevApiKey": "", "DevDailyMessageLimit": 1000 },
  "Otp": { "TtlSeconds": 300, "MaxAttempts": 5, "ResendCooldownSeconds": 60, "PerPhonePerHour": 5, "PerClientPerMinute": 60 },
  "Queue": { "MinDelayMs": 1000, "MaxDelayMs": 3000 },
  "Webhooks": { "Enabled": false, "Url": "", "Secret": "dev-only-webhook-secret" }
}
