{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Database": { "Path": "rasel.db", "MigrateOnStartup": true },
  // DEV-ONLY placeholder secrets (min 32 chars). Outside Development the app refuses to start with them:
  // override with environment variables (Security__OtpPepper, Security__TokenSecret).
  "Security": {
    "OtpPepper": "dev-only-otp-pepper-change-me-0123456789",
    "TokenSecret": "dev-only-token-signing-secret-change-me-32+chars"
  },
  // Optional: set Seed__DevApiKey to choose the dev key; otherwise a random one is generated (logged once in Development only).
  "Seed": { "DevApiKey": "", "DevDailyMessageLimit": 1000 },
  "Cors": { "AllowedOrigins": [] },
  "Api": { "RequestsPerMinute": 600, "FailedAuthPerMinute": 20, "MaxKeyLength": 128, "MaxRequestBodyBytes": 65536, "ShutdownTimeoutSeconds": 30 },
  "Otp": { "TtlSeconds": 300, "MaxAttempts": 5, "CodeLength": 6, "ResendCooldownSeconds": 60, "PerPhonePerHour": 5, "PerClientPerMinute": 60, "AppName": "Rasel" },
  "Outbox": { "PollIntervalMs": 500, "MaxAttempts": 5, "BaseBackoffSeconds": 5, "MaxBackoffSeconds": 900, "LeaseSeconds": 120, "BatchSize": 10 },
  "Pacing": { "MinDelayMs": 1000, "MaxDelayMs": 5000, "MinGapMs": 1500, "DailyPerRecipient": 5 },
  // Fake (default, in-memory), Bridge (real whatsapp-web.js bridge) or WebJs (whatsapp-web.js sidecar over HTTP).
  "WhatsApp": {
    "Provider": "Fake",
    "Bridge": { "BaseUrl": "", "SharedToken": "", "AttemptTimeoutSeconds": 30, "ReadRetries": 2, "BreakerMinimumThroughput": 5, "BreakerFailureRatio": 0.5, "BreakerSamplingSeconds": 30, "BreakerBreakSeconds": 30 },
    "WebJs": { "BaseUrl": "", "ApiToken": "", "AttemptTimeoutSeconds": 10, "ReadRetries": 2, "BreakerMinimumThroughput": 5, "BreakerFailureRatio": 0.5, "BreakerSamplingSeconds": 30, "BreakerBreakSeconds": 30 }
  },
  "Sms": {
    "Provider": "Fake",
    "TextBee": {
      "BaseUrl": "https://api.textbee.dev/api/v1/",
      "ApiKey": "",
      "DeviceId": "",
      "TimeoutSeconds": 15
    }
  },
  "Webhooks": { "Enabled": false, "Url": "", "Secret": "dev-only-webhook-secret" }
}
