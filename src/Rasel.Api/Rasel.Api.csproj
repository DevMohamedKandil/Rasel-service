<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Rasel.Application\Rasel.Application.csproj" />
    <ProjectReference Include="..\Rasel.Infrastructure\Rasel.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <!-- The WhatsApp sidecar (sources + lockfile + patches, never node_modules or sessions) ships with the API; Managed mode copies it to Sidecar:DataDir. -->
  <ItemGroup>
    <None Include="../../sidecar/package.json;../../sidecar/package-lock.json" Link="sidecar/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../sidecar/src/**" Link="sidecar/src/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../sidecar/patches/**" Link="sidecar/patches/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
